# ============================================================
# defectgen — variables de entorno (copiar a `.env`)
# ============================================================
# Copia este fichero a `.env` y rellena los valores antes de
# lanzar `docker compose up -d --build`.

# Puerto del HMI de preprocesado (crop-hmi)
CROP_PORT=8091

# Puerto de la consola de entrenamiento (defectfill)
HOST_PORT=8500

# Puerto del portal (entrada única)
NGINX_PORT=80

# Token de Hugging Face (opcional).
# Crea uno de lectura en https://huggingface.co/settings/tokens
# para mayor velocidad y fiabilidad en la primera descarga del
# modelo stable-diffusion-2-inpainting. Si lo dejas vacío, la
# descarga funciona igual (el modelo es público).
HF_TOKEN=