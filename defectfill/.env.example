# ============================================================
# Variables de entorno configurables (copiar a .env)
# ============================================================

# Puerto expuesto en el host
HOST_PORT=8000

# Puerto del Nginx (solo con docker-compose.prod.yml)
NGINX_PORT=80

# Orígenes CORS separados por coma (por defecto: *)
CORS_ORIGINS=*

# Token de Hugging Face (opcional). Crea uno de lectura en
# https://huggingface.co/settings/tokens para mayor velocidad de descarga.
# Si lo dejas vacío, las descargas funcionan igual (modelo público).
HF_TOKEN=
